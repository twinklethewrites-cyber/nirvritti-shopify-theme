{% doc %}
  @prompt
    Below you may also like it should have product photos in small box like product photo
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-you-may-also-like-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;padding:{{ block.settings.section_padding }}px 0;color:{{ block.settings.text_color }};}
  .ai-you-may-also-like__heading-{{ ai_gen_id }}{margin:0 0 16px;font-size:{{ block.settings.heading_size }}px;line-height:1.25;font-weight:600;}
  .ai-you-may-also-like__list-{{ ai_gen_id }}{display:grid;grid-template-columns:repeat({{ block.settings.columns_desktop }},minmax(0,1fr));gap:12px;margin:0;padding:0;list-style:none;}
  .ai-you-may-also-like__card-{{ ai_gen_id }}{display:flex;align-items:center;gap:12px;min-width:0;padding:8px;border:1px solid {{ block.settings.card_border_color }};border-radius:{{ block.settings.card_radius }}px;background:{{ block.settings.card_background }};color:inherit;text-decoration:none;transition:border-color .2s ease,box-shadow .2s ease;}
  .ai-you-may-also-like__card-{{ ai_gen_id }}:hover,.ai-you-may-also-like__card-{{ ai_gen_id }}:focus-visible{border-color:{{ block.settings.card_hover_border_color }};box-shadow:0 2px 8px rgba(0,0,0,.08);outline:none;}
  .ai-you-may-also-like__image-wrap-{{ ai_gen_id }}{flex:0 0 {{ block.settings.image_size }}px;width:{{ block.settings.image_size }}px;height:{{ block.settings.image_size }}px;overflow:hidden;border-radius:{{ block.settings.image_radius }}px;background:#f3f3f3;}
  .ai-you-may-also-like__image-wrap-{{ ai_gen_id }} img,.ai-you-may-also-like__image-wrap-{{ ai_gen_id }} svg{display:block;width:100%;height:100%;object-fit:cover;}
  .ai-you-may-also-like__info-{{ ai_gen_id }}{min-width:0;}
  .ai-you-may-also-like__title-{{ ai_gen_id }}{display:-webkit-box;overflow:hidden;margin:0 0 5px;color:{{ block.settings.text_color }};font-size:{{ block.settings.title_size }}px;line-height:1.3;font-weight:500;-webkit-box-orient:vertical;-webkit-line-clamp:2;}
  .ai-you-may-also-like__price-{{ ai_gen_id }}{color:{{ block.settings.price_color }};font-size:{{ block.settings.price_size }}px;line-height:1.3;}
  @media screen and (max-width:749px){.ai-you-may-also-like__list-{{ ai_gen_id }}{grid-template-columns:repeat({{ block.settings.columns_mobile }},minmax(0,1fr));}.ai-you-may-also-like__card-{{ ai_gen_id }}{gap:8px;padding:6px;}.ai-you-may-also-like__image-wrap-{{ ai_gen_id }}{flex-basis:56px;width:56px;height:56px;}}
{% endstyle %}
<div class="ai-you-may-also-like-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}<h2 class="ai-you-may-also-like__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>{% endif %}
  {% if block.settings.products != blank %}
    <ul class="ai-you-may-also-like__list-{{ ai_gen_id }}" role="list">
      {% for product in block.settings.products limit: block.settings.product_limit %}<li><a class="ai-you-may-also-like__card-{{ ai_gen_id }}" href="{{ product.url }}" aria-label="View {{ product.title | escape }}"><span class="ai-you-may-also-like__image-wrap-{{ ai_gen_id }}">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 240 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="240" height="240">{% else %}{{ 'product-apparel-1' | placeholder_svg_tag }}{% endif %}</span><span class="ai-you-may-also-like__info-{{ ai_gen_id }}"><span class="ai-you-may-also-like__title-{{ ai_gen_id }}">{{ product.title | escape }}</span><span class="ai-you-may-also-like__price-{{ ai_gen_id }}">{{ product.price | money }}</span></span></a></li>{% endfor %}
    </ul>
  {% else %}<p>Select products to show recommendations.</p>{% endif %}
</div>
{% schema %}
{"name":"You may also like","settings":[{"type":"text","id":"heading","label":"Heading","default":"You may also like"},{"type":"product_list","id":"products","label":"Products","limit":6},{"type":"range","id":"product_limit","label":"Number of products","min":1,"max":6,"step":1,"default":4},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"select","id":"columns_desktop","label":"Columns on desktop","options":[{"value":"1","label":"1"},{"value":"2","label":"2"},{"value":"3","label":"3"}],"default":"2"},{"type":"select","id":"columns_mobile","label":"Columns on mobile","options":[{"value":"1","label":"1"},{"value":"2","label":"2"}],"default":"1"},{"type":"range","id":"image_size","label":"Photo size","min":40,"max":100,"step":5,"unit":"px","default":65},{"type":"range","id":"image_radius","label":"Photo radius","min":0,"max":20,"step":2,"unit":"px","default":6},{"type":"range","id":"card_radius","label":"Card radius","min":0,"max":20,"step":2,"unit":"px","default":8},{"type":"range","id":"section_padding","label":"Vertical spacing","min":0,"max":40,"step":5,"unit":"px","default":15},{"type":"range","id":"heading_size","label":"Heading size","min":14,"max":32,"step":2,"unit":"px","default":20},{"type":"range","id":"title_size","label":"Product title size","min":12,"max":20,"step":1,"unit":"px","default":14},{"type":"range","id":"price_size","label":"Price size","min":11,"max":18,"step":1,"unit":"px","default":13},{"type":"color","id":"text_color","label":"Text","default":"#222222"},{"type":"color","id":"price_color","label":"Price","default":"#555555"},{"type":"color","id":"card_background","label":"Card background","default":"#FFFFFF"},{"type":"color","id":"card_border_color","label":"Card border","default":"#E2E2E2"},{"type":"color","id":"card_hover_border_color","label":"Hover border","default":"#555555"}],"presets":[{"name":"You may also like"}],"tag":null,"class":"you-may-also-like-block"}
{% endschema %}