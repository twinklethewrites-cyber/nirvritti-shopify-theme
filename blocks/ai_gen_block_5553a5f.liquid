{% doc %}
  @prompt
    Can you add contact number  and address 9n contact page- Reti Bunder Road, near vaillankani school, Dombivli, Thakurwadi, Dombivli West, Kalyan, Maharashtra 421202
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-contact-details-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding }}px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    box-sizing: border-box;
  }

  .ai-contact-details-{{ ai_gen_id }}__heading {
    margin: 0 0 20px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
  }

  .ai-contact-details-{{ ai_gen_id }}__items {
    display: grid;
    gap: 16px;
  }

  .ai-contact-details-{{ ai_gen_id }}__item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .ai-contact-details-{{ ai_gen_id }}__icon {
    display: inline-flex;
    flex: 0 0 auto;
    width: 22px;
    height: 22px;
    color: {{ block.settings.icon_color }};
  }

  .ai-contact-details-{{ ai_gen_id }}__icon svg {
    width: 100%;
    height: 100%;
  }

  .ai-contact-details-{{ ai_gen_id }}__label {
    display: block;
    margin-bottom: 4px;
    color: {{ block.settings.label_color }};
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .ai-contact-details-{{ ai_gen_id }}__value,
  .ai-contact-details-{{ ai_gen_id }}__value a {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: 16px;
    line-height: 1.5;
  }

  .ai-contact-details-{{ ai_gen_id }}__value a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ai-contact-details-{{ ai_gen_id }}__value a:focus-visible {
    outline: 2px solid {{ block.settings.icon_color }};
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .ai-contact-details-{{ ai_gen_id }} {
      width: 100%;
      padding: {{ block.settings.mobile_padding }}px;
    }
  }
{% endstyle %}

<contact-details-{{ ai_gen_id }} class="ai-contact-details-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-contact-details-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  {% endif %}

  <div class="ai-contact-details-{{ ai_gen_id }}__items">
    {% if block.settings.phone_number != blank %}
      <div class="ai-contact-details-{{ ai_gen_id }}__item">
        <span class="ai-contact-details-{{ ai_gen_id }}__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.78.62 2.63a2 2 0 0 1-.45 2.11L8 9.73a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.85.29 1.73.5 2.63.62A2 2 0 0 1 22 16.92Z"></path>
          </svg>
        </span>
        <div>
          <span class="ai-contact-details-{{ ai_gen_id }}__label">{{ block.settings.phone_label | escape }}</span>
          <p class="ai-contact-details-{{ ai_gen_id }}__value"><a href="tel:{{ block.settings.phone_number | remove: ' ' | remove: '-' | remove: '(' | remove: ')' }}">{{ block.settings.phone_number | escape }}</a></p>
        </div>
      </div>
    {% endif %}

    {% if block.settings.address != blank %}
      <div class="ai-contact-details-{{ ai_gen_id }}__item">
        <span class="ai-contact-details-{{ ai_gen_id }}__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"></path>
            <circle cx="12" cy="10" r="2.5"></circle>
          </svg>
        </span>
        <div>
          <span class="ai-contact-details-{{ ai_gen_id }}__label">{{ block.settings.address_label | escape }}</span>
          <p class="ai-contact-details-{{ ai_gen_id }}__value">{{ block.settings.address | escape | newline_to_br }}</p>
        </div>
      </div>
    {% endif %}
  </div>
</contact-details-{{ ai_gen_id }}>

<script>
  (function() {
    if (!customElements.get('contact-details-{{ ai_gen_id }}')) {
      class ContactDetails{{ ai_gen_id }} extends HTMLElement {}
      customElements.define('contact-details-{{ ai_gen_id }}', ContactDetails{{ ai_gen_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "Contact details",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact us" },
    { "type": "text", "id": "phone_label", "label": "Phone label", "default": "Phone" },
    { "type": "text", "id": "phone_number", "label": "Phone number" },
    { "type": "text", "id": "address_label", "label": "Address label", "default": "Address" },
    { "type": "textarea", "id": "address", "label": "Address", "default": "Reti Bunder Road, near vaillankani school, Dombivli, Thakurwadi, Dombivli West, Kalyan, Maharashtra 421202" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "padding", "label": "Padding", "min": 12, "max": 60, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "mobile_padding", "label": "Mobile padding", "min": 12, "max": 40, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "border_radius", "label": "Corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 18, "max": 40, "step": 2, "unit": "px", "default": 26 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#D9D9D9" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#1F1F1F" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#333333" },
    { "type": "color", "id": "label_color", "label": "Labels", "default": "#555555" },
    { "type": "color", "id": "icon_color", "label": "Icons", "default": "#333333" }
  ],
  "presets": [{ "name": "Contact details" }],
  "tag": null,
  "class": "contact-details-block"
}
{% endschema %}