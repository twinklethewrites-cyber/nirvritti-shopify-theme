{% doc %}
  @prompt
    All products page, keep product photos in circle
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-all-products-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-all-products-{{ ai_gen_id }}__inner {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-all-products-{{ ai_gen_id }}__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
  }

  .ai-all-products-{{ ai_gen_id }}__title {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.15;
  }

  .ai-all-products-{{ ai_gen_id }}__count {
    margin: 0;
    color: {{ block.settings.muted_color }};
    font-size: 14px;
  }

  .ai-all-products-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-all-products-{{ ai_gen_id }}__card {
    min-width: 0;
    color: {{ block.settings.text_color }};
  }

  .ai-all-products-{{ ai_gen_id }}__image-wrap {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: {{ block.settings.image_background }};
    border-radius: 50%;
  }

  .ai-all-products-{{ ai_gen_id }}__image-wrap img,
  .ai-all-products-{{ ai_gen_id }}__image-wrap svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-all-products-{{ ai_gen_id }}__image-wrap img {
    transition: transform 0.25s ease;
  }

  .ai-all-products-{{ ai_gen_id }}__card:hover img {
    transform: scale(1.03);
  }

  .ai-all-products-{{ ai_gen_id }}__info {
    padding-top: 14px;
    text-align: center;
  }

  .ai-all-products-{{ ai_gen_id }}__product-title {
    display: block;
    margin: 0 0 6px;
    color: inherit;
    font-size: 16px;
    line-height: 1.35;
    text-decoration: none;
  }

  .ai-all-products-{{ ai_gen_id }}__product-title:hover,
  .ai-all-products-{{ ai_gen_id }}__product-title:focus-visible {
    text-decoration: underline;
  }

  .ai-all-products-{{ ai_gen_id }}__price {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: 15px;
    font-weight: 600;
  }

  .ai-all-products-{{ ai_gen_id }}__empty {
    padding: 32px;
    color: {{ block.settings.muted_color }};
    background: {{ block.settings.image_background }};
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-all-products-{{ ai_gen_id }}__inner {
      width: 100%;
    }

    .ai-all-products-{{ ai_gen_id }}__header {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }

    .ai-all-products-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr));
      gap: {{ block.settings.grid_gap | times: 0.8 }}px;
    }

    .ai-all-products-{{ ai_gen_id }}__title {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<all-products-grid-{{ ai_gen_id }} class="ai-all-products-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-all-products-{{ ai_gen_id }}__inner">
    {% assign products_source = collection.products %}
    {% if products_source == blank %}
      {% assign products_source = collections.all.products %}
    {% endif %}

    <div class="ai-all-products-{{ ai_gen_id }}__header">
      <h2 class="ai-all-products-{{ ai_gen_id }}__title">{{ block.settings.heading }}</h2>
      {% if block.settings.show_count and products_source != blank %}
        <p class="ai-all-products-{{ ai_gen_id }}__count">{{ collection.products_count | default: 0 }} products</p>
      {% endif %}
    </div>

    {% if products_source != blank %}
      <div class="ai-all-products-{{ ai_gen_id }}__grid">
        {% for product in products_source limit: block.settings.product_limit %}
          <article class="ai-all-products-{{ ai_gen_id }}__card">
            <a href="{{ product.url }}" class="ai-all-products-{{ ai_gen_id }}__image-wrap" aria-label="{{ product.title | escape }}">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="900" height="900">
              {% else %}
                {{ 'product-apparel-1' | placeholder_svg_tag }}
              {% endif %}
            </a>
            <div class="ai-all-products-{{ ai_gen_id }}__info">
              <a href="{{ product.url }}" class="ai-all-products-{{ ai_gen_id }}__product-title">{{ product.title }}</a>
              <p class="ai-all-products-{{ ai_gen_id }}__price">{{ product.price | money }}</p>
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-all-products-{{ ai_gen_id }}__empty">Add products to your store to display them here.</div>
    {% endif %}
  </div>
</all-products-grid-{{ ai_gen_id }}>

<script>
  (function() {
    if (!customElements.get('all-products-grid-{{ ai_gen_id }}')) {
      class AllProductsGrid{{ ai_gen_id }} extends HTMLElement {}
      customElements.define('all-products-grid-{{ ai_gen_id }}', AllProductsGrid{{ ai_gen_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "All products page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "All products" },
    { "type": "checkbox", "id": "show_count", "label": "Show product count", "default": true },
    { "type": "range", "id": "product_limit", "label": "Products to show", "min": 4, "max": 50, "step": 1, "default": 24 },
    { "type": "select", "id": "columns_desktop", "label": "Columns on desktop", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "4" },
    { "type": "select", "id": "columns_mobile", "label": "Columns on mobile", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "2" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "grid_gap", "label": "Grid gap", "min": 8, "max": 40, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 56, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "card_radius", "label": "Card radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 8 },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#24150F" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#24150F" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#5F514B" },
    { "type": "color", "id": "image_background", "label": "Image background", "default": "#F6EFE9" }
  ],
  "presets": [{ "name": "All products page" }],
  "tag": null,
  "class": "all-products-page-block"
}
{% endschema %}