{% doc %}
  @prompt
    Add text about brand before products section start
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-brand-intro-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.padding_top }}px 24px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    text-align: {{ block.settings.alignment }};
  }

  .ai-brand-intro__inner-{{ ai_gen_id }} {
    width: 100%;
    max-width: {{ block.settings.content_width }}px;
    margin: 0 auto;
  }

  .ai-brand-intro__eyebrow-{{ ai_gen_id }} {
    margin: 0 0 10px;
    color: {{ block.settings.accent_color }};
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .ai-brand-intro__heading-{{ ai_gen_id }} {
    margin: 0 0 14px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.15;
  }

  .ai-brand-intro__text-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.65;
  }

  .ai-brand-intro__text-{{ ai_gen_id }} p {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-brand-intro-{{ ai_gen_id }} {
      width: 100%;
      padding-right: 18px;
      padding-left: 18px;
    }

    .ai-brand-intro__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-brand-intro__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<brand-intro-{{ ai_gen_id }}
  class="ai-brand-intro-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-brand-intro__inner-{{ ai_gen_id }}">
    {% if block.settings.eyebrow != blank %}
      <p class="ai-brand-intro__eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow | escape }}</p>
    {% endif %}

    {% if block.settings.heading != blank %}
      <h2 class="ai-brand-intro__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>
    {% endif %}

    {% if block.settings.description != blank %}
      <div class="ai-brand-intro__text-{{ ai_gen_id }}">{{ block.settings.description }}</div>
    {% endif %}
  </div>
</brand-intro-{{ ai_gen_id }}>

<script>
  (function() {
    if (!customElements.get('brand-intro-{{ ai_gen_id }}')) {
      class BrandIntro{{ ai_gen_id }} extends HTMLElement {}
      customElements.define('brand-intro-{{ ai_gen_id }}', BrandIntro{{ ai_gen_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "Brand introduction",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Nirvritti story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Thoughtfully made chocolate"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover handcrafted chocolates made with carefully chosen ingredients, joyful flavours and a little everyday indulgence.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 400,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "default": 800
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 17
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFF8F0"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#3B2118"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#4A332B"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#7A351D"
    }
  ],
  "presets": [
    {
      "name": "Brand introduction"
    }
  ],
  "tag": null,
  "class": "brand-introduction-block"
}
{% endschema %}