{% doc %}
  @prompt
    Create a Best Sellers section for the home page that displays products from a selected collection in a responsive product grid. The section should include a heading (default: "Best Sellers"), a subheading, and show product cards with image, title, price, and an add-to-cart or view product button. The section should have a setting to select which collection to display, and a setting to control how many products to show (default 4). Style it to feel clean, modern, and natural — consistent with a wellness/natural products brand. Place this section below the Shop FIT-ROOT section on the home page.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-best-sellers-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 24px;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-best-sellers-{{ ai_gen_id }}__inner {
    max-width: 1280px;
    margin: 0 auto;
  }

  .ai-best-sellers-{{ ai_gen_id }}__header {
    max-width: 680px;
    margin: 0 auto 32px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-best-sellers-{{ ai_gen_id }}__heading {
    margin: 0 0 10px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .ai-best-sellers-{{ ai_gen_id }}__subheading {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: 16px;
    line-height: 1.6;
  }

  .ai-best-sellers-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: 24px;
  }

  .ai-best-sellers-{{ ai_gen_id }}__card {
    min-width: 0;
  }

  .ai-best-sellers-{{ ai_gen_id }}__image-link {
    display: block;
    overflow: hidden;
    margin-bottom: 16px;
    border-radius: {{ block.settings.image_radius }}px;
    background: #edf1e9;
    aspect-ratio: 1 / 1;
  }

  .ai-best-sellers-{{ ai_gen_id }}__image-link img,
  .ai-best-sellers-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-best-sellers-{{ ai_gen_id }}__placeholder {
    width: 100%;
    height: 100%;
  }

  .ai-best-sellers-{{ ai_gen_id }}__title {
    margin: 0 0 7px;
    color: {{ block.settings.heading_color }};
    font-size: 17px;
    line-height: 1.35;
    font-weight: 600;
  }

  .ai-best-sellers-{{ ai_gen_id }}__title a {
    color: inherit;
    text-decoration: none;
  }

  .ai-best-sellers-{{ ai_gen_id }}__price {
    margin-bottom: 14px;
    color: {{ block.settings.text_color }};
    font-size: 15px;
  }

  .ai-best-sellers-{{ ai_gen_id }}__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 44px;
    padding: 10px 16px;
    border: 1px solid {{ block.settings.button_color }};
    border-radius: {{ block.settings.button_radius }}px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font: inherit;
    font-size: 14px;
    cursor: pointer;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .ai-best-sellers-{{ ai_gen_id }}__button:hover,
  .ai-best-sellers-{{ ai_gen_id }}__button:focus-visible {
    opacity: 0.82;
  }

  .ai-best-sellers-{{ ai_gen_id }}__button:focus-visible,
  .ai-best-sellers-{{ ai_gen_id }}__title a:focus-visible,
  .ai-best-sellers-{{ ai_gen_id }}__image-link:focus-visible {
    outline: 3px solid {{ block.settings.heading_color }};
    outline-offset: 3px;
  }

  .ai-best-sellers-{{ ai_gen_id }}__empty {
    padding: 32px;
    border: 1px solid #d8ded2;
    border-radius: {{ block.settings.image_radius }}px;
    color: {{ block.settings.text_color }};
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-best-sellers-{{ ai_gen_id }} {
      padding-right: 16px;
      padding-left: 16px;
    }

    .ai-best-sellers-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr));
      gap: 20px 12px;
    }

    .ai-best-sellers-{{ ai_gen_id }}__heading {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-best-sellers-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-best-sellers-{{ ai_gen_id }}__inner">
    <div class="ai-best-sellers-{{ ai_gen_id }}__header">
      {% if block.settings.heading != blank %}<h2 class="ai-best-sellers-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
      {% if block.settings.subheading != blank %}<p class="ai-best-sellers-{{ ai_gen_id }}__subheading">{{ block.settings.subheading | escape }}</p>{% endif %}
    </div>

    {% if block.settings.collection != blank and block.settings.collection.products_count > 0 %}
      <div class="ai-best-sellers-{{ ai_gen_id }}__grid">
        {% for product in block.settings.collection.products limit: block.settings.product_count %}
          <article class="ai-best-sellers-{{ ai_gen_id }}__card">
            <a class="ai-best-sellers-{{ ai_gen_id }}__image-link" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="800" height="800">
              {% else %}
                <div class="ai-best-sellers-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
              {% endif %}
            </a>
            <h3 class="ai-best-sellers-{{ ai_gen_id }}__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
            <div class="ai-best-sellers-{{ ai_gen_id }}__price">{{ product.price | money }}</div>
            {% if product.available and product.has_only_default_variant %}
              {% form 'product', product %}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <button class="ai-best-sellers-{{ ai_gen_id }}__button" type="submit">{{ block.settings.add_button_label | escape }}</button>
              {% endform %}
            {% else %}
              <a class="ai-best-sellers-{{ ai_gen_id }}__button" href="{{ product.url }}">{{ block.settings.view_button_label | escape }}</a>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-best-sellers-{{ ai_gen_id }}__empty">Select a collection to display your best sellers.</div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Best sellers",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Best Sellers"},
    {"type":"textarea","id":"subheading","label":"Subheading","default":"Thoughtfully chosen essentials for your everyday wellness routine."},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"product_count","label":"Products to show","min":2,"max":12,"step":1,"default":4},
    {"type":"text","id":"add_button_label","label":"Add button label","default":"Add to cart"},
    {"type":"text","id":"view_button_label","label":"View button label","default":"View product"},
    {"type":"header","content":"Layout"},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"select","id":"columns_desktop","label":"Columns on desktop","options":[{"value":"2","label":"2"},{"value":"3","label":"3"},{"value":"4","label":"4"}],"default":"4"},
    {"type":"select","id":"columns_mobile","label":"Columns on mobile","options":[{"value":"1","label":"1"},{"value":"2","label":"2"}],"default":"2"},
    {"type":"radio","id":"text_alignment","label":"Alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"}],"default":"center"},
    {"type":"header","content":"Style"},
    {"type":"color","id":"background_color","label":"Background","default":"#F7F8F3"},
    {"type":"color","id":"heading_color","label":"Heading","default":"#24352B"},
    {"type":"color","id":"text_color","label":"Text","default":"#4B5B50"},
    {"type":"color","id":"button_color","label":"Button","default":"#365542"},
    {"type":"color","id":"button_text_color","label":"Button text","default":"#FFFFFF"},
    {"type":"range","id":"section_padding","label":"Section spacing","min":20,"max":100,"step":5,"unit":"px","default":60},
    {"type":"range","id":"image_radius","label":"Image radius","min":0,"max":24,"step":2,"unit":"px","default":12},
    {"type":"range","id":"button_radius","label":"Button radius","min":0,"max":24,"step":2,"unit":"px","default":6},
    {"type":"range","id":"heading_size","label":"Heading size","min":24,"max":64,"step":2,"unit":"px","default":42}
  ],
  "presets": [{"name":"Best sellers"}],
  "tag": null,
  "class": "best-sellers-block"
}
{% endschema %}