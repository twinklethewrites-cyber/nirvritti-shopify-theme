<div class="container section-padding" style="max-width:440px;">
  <h1 class="section-heading text-center">Reset Password</h1>
  {%- form 'reset_customer_password' -%}
    {%- if form.errors -%}<div class="form-success" style="background:#FBE7EE;color:#C24A6B;">{{ form.errors | default_errors }}</div>{%- endif -%}
    <input type="password" name="customer[password]" placeholder="New password" required style="width:100%;padding:14px;border-radius:var(--radius);border:1px solid rgba(23,59,80,.15);margin-bottom:12px;">
    <input type="password" name="customer[password_confirmation]" placeholder="Confirm new password" required style="width:100%;padding:14px;border-radius:var(--radius);border:1px solid rgba(23,59,80,.15);margin-bottom:16px;">
    <button type="submit" class="btn btn-primary btn-block">Reset Password</button>
  {%- endform -%}
</div>
