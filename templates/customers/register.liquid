<div class="container section-padding" style="max-width:440px;">
  <h1 class="section-heading text-center">Create Account</h1>
  {%- form 'create_customer' -%}
    {%- if form.errors -%}
      <div class="form-success" style="background:#FBE7EE;color:#C24A6B;">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <div style="display:grid;gap:14px;margin-bottom:16px;">
      <input type="text" name="customer[first_name]" placeholder="First name" style="padding:14px;border-radius:var(--radius);border:1px solid rgba(23,59,80,.15);">
      <input type="text" name="customer[last_name]" placeholder="Last name" style="padding:14px;border-radius:var(--radius);border:1px solid rgba(23,59,80,.15);">
      <input type="email" name="customer[email]" placeholder="Email" required style="padding:14px;border-radius:var(--radius);border:1px solid rgba(23,59,80,.15);">
      <input type="password" name="customer[password]" placeholder="Password" required style="padding:14px;border-radius:var(--radius);border:1px solid rgba(23,59,80,.15);">
    </div>
    <button type="submit" class="btn btn-primary btn-block">Create Account</button>
  {%- endform -%}
  <p class="text-center" style="margin-top:24px;font-size:14px;">Already have an account? <a href="{{ routes.account_login_url }}">Sign in</a></p>
</div>
