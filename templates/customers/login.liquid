<div class="container section-padding" style="max-width:440px;">
  <h1 class="section-heading text-center">Sign In</h1>
  {%- form 'customer_login' -%}
    {%- if form.errors -%}
      <div class="form-success" style="background:#FBE7EE;color:#C24A6B;">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <div style="margin-bottom:16px;">
      <label class="visually-hidden" for="CustomerEmail">Email</label>
      <input type="email" name="customer[email]" id="CustomerEmail" placeholder="Email" required autocomplete="email" style="width:100%;padding:14px;border-radius:var(--radius);border:1px solid rgba(23,59,80,.15);">
    </div>
    {%- if form.password_needed -%}
      <div style="margin-bottom:16px;">
        <label class="visually-hidden" for="CustomerPassword">Password</label>
        <input type="password" name="customer[password]" id="CustomerPassword" placeholder="Password" required autocomplete="current-password" style="width:100%;padding:14px;border-radius:var(--radius);border:1px solid rgba(23,59,80,.15);">
      </div>
    {%- endif -%}
    <button type="submit" class="btn btn-primary btn-block">Sign In</button>
    <p class="text-center" style="margin-top:16px;font-size:14px;">
      <a href="#recover" onclick="document.getElementById('RecoverForm').style.display='block';this.parentElement.style.display='none';return false;">Forgot your password?</a>
    </p>
  {%- endform -%}

  <div id="RecoverForm" style="display:none;">
    <h2 style="font-size:18px;">Reset your password</h2>
    {%- form 'recover_customer_password' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-success">If that email exists, a reset link is on its way.</p>
      {%- endif -%}
      <input type="email" name="email" placeholder="Email" required style="width:100%;padding:14px;border-radius:var(--radius);border:1px solid rgba(23,59,80,.15);margin-bottom:12px;">
      <button type="submit" class="btn btn-secondary btn-block">Send Reset Link</button>
    {%- endform -%}
  </div>

  <p class="text-center" style="margin-top:24px;font-size:14px;">New here? <a href="{{ routes.account_register_url }}">Create an account</a></p>
</div>
