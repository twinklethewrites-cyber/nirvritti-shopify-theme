<div class="container section-padding" style="text-align:center;">
  {%- if settings.logo -%}
    <img src="{{ settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" width="110" height="{{ 110 | divided_by: settings.logo.aspect_ratio }}" style="width:110px;margin:0 auto 24px;">
  {%- endif -%}
  <h1 class="section-heading">Nature's Healing Touch</h1>
  <p class="section-subheading" style="margin:0 auto 32px;">We're putting the finishing touches on {{ shop.name }}. Leave your email and we'll let you know the moment we open.</p>

  {%- form 'customer', id: 'PasswordNewsletterForm' -%}
    <input type="hidden" name="contact[tags]" value="newsletter, password page">
    <div class="newsletter-form" style="max-width:420px;margin:0 auto;">
      <input type="email" name="contact[email]" placeholder="Your email address" required style="border:1px solid rgba(23,59,80,0.15);">
      <button type="submit" class="btn btn-primary">Notify Me</button>
    </div>
    {%- if form.posted_successfully? -%}<p class="form-success" style="display:inline-block;">Thank you — we'll be in touch!</p>{%- endif -%}
  {%- endform -%}

  {%- if shop.password_message != blank -%}
    <div class="rte" style="margin-top:32px;">{{ shop.password_message }}</div>
  {%- endif -%}

  {%- if shop.password_url -%}
    <p style="margin-top:32px;font-size:13px;"><a href="{{ shop.password_url }}#login">Store owner login</a></p>
  {%- endif -%}
</div>
