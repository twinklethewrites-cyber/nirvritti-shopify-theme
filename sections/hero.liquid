<div class="hero" style="--overlay:{{ section.settings.overlay_opacity | divided_by: 100.0 }}; height:{{ section.settings.height }}px;">
  <div class="hero__media" style="height:{{ section.settings.height }}px;">
    {%- if section.settings.image -%}
      <img
        src="{{ section.settings.image | image_url: width: 1600 }}"
        srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1200 }} 1200w, {{ section.settings.image | image_url: width: 1600 }} 1600w, {{ section.settings.image | image_url: width: 2000 }} 2000w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
        {% if section.settings.image_mobile != blank %}class="hide-mobile"{% endif %}
        fetchpriority="high" width="1600" height="{{ section.settings.height }}">
    {%- endif -%}
    {%- if section.settings.image_mobile != blank -%}
      <style>
        @media (max-width: 749px) {
          .hero-{{ section.id }} .hero__media img:not(.hero-mobile-img) { display: none; }
        }
        @media (min-width: 750px) { .hero-mobile-img { display: none; } }
      </style>
      <img class="hero-mobile-img" src="{{ section.settings.image_mobile | image_url: width: 900 }}" alt="{{ section.settings.heading | escape }}" width="900" height="{{ section.settings.height }}">
    {%- endif -%}
    <div class="hero__overlay"></div>
  </div>
  <div class="hero__content align-{{ section.settings.text_align }}">
    <div class="hero__inner">
      <h1 class="hero__heading">{{ section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}
        <p class="hero__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
      <div class="hero__ctas align-{{ section.settings.text_align }}">
        {%- if section.settings.primary_label != blank -%}
          <a href="{{ section.settings.primary_link }}" class="btn btn-primary">{{ section.settings.primary_label }}</a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a href="{{ section.settings.secondary_link }}" class="btn btn-light">{{ section.settings.secondary_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image (optional)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Chocolate, Reimagined by Nature." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Discover thoughtfully crafted chocolates made with natural ingredients, created for energy, wellness, little ones and life's special moments." },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Shop FIT-ROOT" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Discover Our Story" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" },
    { "type": "select", "id": "text_align", "label": "Text alignment", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }
    ], "default": "left" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Overlay opacity", "default": 35 },
    { "type": "range", "id": "height", "min": 400, "max": 900, "step": 20, "unit": "px", "label": "Section height", "default": 680 }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
