<div class="container section-padding">
  <div class="section-header reveal"><h1 class="section-heading">{{ blog.title }}</h1></div>
  <div class="product-grid" style="--cols-desktop:3;--cols-mobile:1;">
    {%- paginate blog.articles by 9 -%}
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="product-card">
          <div class="product-card__media">
            {%- if article.image -%}<img class="img-primary" src="{{ article.image | image_url: width: 600 }}" alt="{{ article.title | escape }}" loading="lazy" width="600" height="600">{%- endif -%}
          </div>
          <div class="product-card__info">
            <h3 class="product-card__title">{{ article.title }}</h3>
            <p class="product-card__desc">{{ article.excerpt_or_content | strip_html | truncate: 100 }}</p>
          </div>
        </a>
      {%- endfor -%}
      {%- if paginate.pages > 1 -%}
        <nav class="pagination">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">&larr;</a>{%- endif -%}
          {%- for part in paginate.parts -%}{%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span class="is-current">{{ part.title }}</span>{%- endif -%}{%- endfor -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}">&rarr;</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>
{% schema %}{ "name": "Blog", "settings": [] }{% endschema %}
