<div class="container section-padding">
  <h1 class="section-heading">Your Cart</h1>
  {%- if cart.item_count == 0 -%}
    <div class="empty-state">
      <p>Your cart is empty.</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary">Continue Shopping</a>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" novalidate>
      {%- for item in cart.items -%}
        <div class="cart-line">
          <img class="cart-line__img" src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" width="84" height="84">
          <div>
            <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title }}</a>
            {%- unless item.variant.title == 'Default Title' -%}<div class="cart-line__variant">{{ item.variant.title }}</div>{%- endunless -%}
            <div class="qty-stepper">
              <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" style="width:60px;text-align:center;border:1px solid rgba(23,59,80,.15);border-radius:8px;padding:6px;">
            </div>
          </div>
          <div class="price">{{ item.final_line_price | money }}</div>
        </div>
      {%- endfor -%}
      <div style="max-width:320px;margin-left:auto;margin-top:24px;">
        <div class="cart-subtotal"><span>Subtotal</span><span>{{ cart.total_price | money }}</span></div>
        <button type="submit" name="update" class="btn btn-secondary btn-block" style="margin-bottom:10px;">Update Cart</button>
        <button type="submit" name="checkout" class="btn btn-primary btn-block">Checkout</button>
      </div>
    </form>
  {%- endif -%}
</div>

{% schema %}
{ "name": "Cart page", "settings": [] }
{% endschema %}
