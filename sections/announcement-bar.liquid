<div class="announcement-bar" style="background:{{ section.settings.bg_color }}; color:{{ section.settings.text_color }};">
  <div class="container announcement-bar__track">
    {%- for block in section.blocks -%}
      {%- if block.type == 'message' -%}
        <div class="announcement-bar__slide{% if forloop.first %} is-active{% endif %}" data-announcement-slide {{ block.shopify_attributes }}>
          {%- if block.settings.link -%}<a href="{{ block.settings.link }}">{%- endif -%}
          {{ block.settings.text }}
          {%- if block.settings.link -%}</a>{%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#173B50" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Message", "default": "Made with 15 Natural Ingredients • Handmade with Care" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "text": "Made with 15 Natural Ingredients • Handmade with Care" } },
        { "type": "message", "settings": { "text": "Free shipping on prepaid orders above ₹599" } }
      ]
    }
  ]
}
{% endschema %}
