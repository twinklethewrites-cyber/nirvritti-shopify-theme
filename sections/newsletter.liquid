{%- if section.settings.enable -%}
<div class="section-padding" style="padding-bottom:0;">
  <div class="container">
    <div class="newsletter reveal">
      <h2 class="newsletter__heading section-heading">{{ section.settings.heading }}</h2>
      <p class="newsletter__text">{{ section.settings.text }}</p>
      {%- form 'customer', id: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="newsletter-form">
          <label class="visually-hidden" for="NewsletterEmail">Email address</label>
          <input type="email" name="contact[email]" id="NewsletterEmail" placeholder="Your email address" required>
          <button type="submit" class="btn btn-light">Subscribe</button>
        </div>
        {%- if form.posted_successfully? -%}
          <p class="form-success">Thank you for subscribing!</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "checkbox", "id": "enable", "label": "Enable section", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A Little More Goodness, Occasionally." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Get new product launches, offers and stories from Nirvritti." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
