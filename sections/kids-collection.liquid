<div class="section-padding">
  <div class="container">
    <div class="kids-section reveal">
      <div class="kids-section__inner">
        <div class="kids-section__text">
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
          <h2 class="editorial__heading">{{ section.settings.heading }}</h2>
          <p class="editorial__text">{{ section.settings.text }}</p>
          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_link }}" class="btn btn-primary">{{ section.settings.button_label }}</a>
          {%- endif -%}
          <div class="kids-products">
            {%- for block in section.blocks -%}
              {%- if block.settings.product != blank -%}
                {% render 'product-card', product: block.settings.product, show_quick_add: false %}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
        <div class="kids-section__media">
          {%- if section.settings.image -%}
            <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.heading | escape }}" loading="lazy" width="900" height="675">
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Kids collection",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Kids Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Little Ones. Big Smiles." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Fun shapes, playful packaging and chocolate made with natural ingredients." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Kids Collection" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "product", "name": "Product", "settings": [{ "type": "product", "id": "product", "label": "Product" }] }
  ],
  "presets": [{ "name": "Kids collection" }]
}
{% endschema %}
