<div class="section-padding">
  <div class="container">
    <div class="section-header reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="section-heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="section-subheading">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <div class="product-grid reveal-stagger" style="--cols-desktop:{{ section.settings.columns_desktop }}; --cols-mobile:{{ section.settings.columns_mobile }};">
      {%- if section.settings.collection != blank -%}
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.product != blank -%}
            {% render 'product-card', product: block.settings.product %}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <div class="text-center" style="margin-top:40px;">
        <a href="{{ section.settings.button_link }}" class="btn btn-secondary">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Best sellers",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Fan Favourites" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best Sellers" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave blank to hand-pick products with blocks below" },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 12, "step": 1, "label": "Products to show", "default": 8 },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 5, "step": 1, "label": "Desktop columns", "default": 4 },
    { "type": "range", "id": "columns_mobile", "min": 1, "max": 2, "step": 1, "label": "Mobile columns", "default": 2 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop All" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [{ "type": "product", "id": "product", "label": "Product" }]
    }
  ],
  "presets": [{ "name": "Best sellers" }]
}
{% endschema %}
