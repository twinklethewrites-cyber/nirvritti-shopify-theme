<div class="section-padding">
  <div class="container">
    <div class="editorial reveal{% if section.settings.image_position == 'right' %} reverse{% endif %}">
      <div class="editorial__media">
        {%- if section.settings.image -%}
          <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.heading | escape }}" loading="lazy" width="900" height="1125">
        {%- endif -%}
      </div>
      <div>
        <span class="eyebrow editorial__eyebrow">{{ section.settings.eyebrow }}</span>
        <h2 class="editorial__heading">{{ section.settings.heading }}</h2>
        <p class="editorial__text">{{ section.settings.text }}</p>
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="btn btn-primary">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "FIT-ROOT Story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "image_position", "label": "Image position", "options": [
      { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }
    ], "default": "left" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The FIT-ROOT Story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "More Than Chocolate." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "FIT-ROOT brings together chocolate and natural ingredients to create something designed for today's lifestyle." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Discover FIT-ROOT" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "FIT-ROOT Story" }]
}
{% endschema %}
