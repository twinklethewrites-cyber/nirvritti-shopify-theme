[
  {
    "name": "theme_info",
    "theme_name": "Nirvritti Premium",
    "theme_version": "1.0.0",
    "theme_author": "Nirvritti",
    "theme_documentation_url": "https://nirvritti.com",
    "theme_support_url": "https://nirvritti.com"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 260,
        "step": 5,
        "unit": "px",
        "label": "Desktop logo width",
        "default": 150
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image",
        "info": "Will be scaled down to 32 x 32px"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Brand palette"
      },
      { "type": "color", "id": "color_primary", "label": "Primary (deep navy)", "default": "#173B50" },
      { "type": "color", "id": "color_secondary", "label": "Secondary (natural green)", "default": "#62A96B" },
      { "type": "color", "id": "color_sage", "label": "Soft sage", "default": "#DCEFE7" },
      { "type": "color", "id": "color_accent", "label": "Accent (aqua)", "default": "#4BA9C5" },
      { "type": "color", "id": "color_background", "label": "Page background", "default": "#F7FAF8" },
      { "type": "color", "id": "color_surface", "label": "Surface / card background", "default": "#FFFFFF" },
      { "type": "color", "id": "color_text", "label": "Deep text", "default": "#172126" },
      { "type": "color", "id": "color_muted", "label": "Muted text", "default": "#667276" },
      { "type": "header", "content": "Buttons" },
      { "type": "color", "id": "color_button_bg", "label": "Primary button background", "default": "#62A96B" },
      { "type": "color", "id": "color_button_text", "label": "Primary button text", "default": "#FFFFFF" }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading font",
        "default": "cormorant_garamond_n6"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body / UI font",
        "default": "dm_sans_n4"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1200,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "label": "Page width",
        "default": 1360
      },
      {
        "type": "range",
        "id": "spacing_sections",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "Space between sections",
        "default": 0
      }
    ]
  },
  {
    "name": "Buttons & cards",
    "settings": [
      {
        "type": "range",
        "id": "border_radius",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "px",
        "label": "Corner radius",
        "default": 10
      },
      {
        "type": "select",
        "id": "shadow_intensity",
        "label": "Shadow intensity",
        "options": [
          { "value": "none", "label": "None" },
          { "value": "soft", "label": "Soft" },
          { "value": "medium", "label": "Medium" }
        ],
        "default": "soft"
      }
    ]
  },
  {
    "name": "Animation",
    "settings": [
      {
        "type": "select",
        "id": "animation_intensity",
        "label": "Animation intensity",
        "options": [
          { "value": "none", "label": "None (no motion)" },
          { "value": "subtle", "label": "Subtle luxury (recommended)" },
          { "value": "expressive", "label": "Expressive" }
        ],
        "default": "subtle",
        "info": "Reduced-motion preferences are always respected."
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart behavior",
        "options": [
          { "value": "drawer", "label": "Drawer" },
          { "value": "page", "label": "Cart page" }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_free_shipping",
        "label": "Show free shipping progress bar",
        "default": true
      },
      {
        "type": "number",
        "id": "cart_free_shipping_threshold",
        "label": "Free shipping threshold (in your currency, e.g. 599)",
        "default": 599
      }
    ]
  },
  {
    "name": "WhatsApp ordering",
    "settings": [
      {
        "type": "paragraph",
        "content": "Use this while you don't have online payments set up yet. Adds a WhatsApp order button to every product page (and an optional floating button site-wide) that opens a pre-filled chat with the product, price and link."
      },
      {
        "type": "checkbox",
        "id": "enable_whatsapp_order",
        "label": "Enable WhatsApp ordering",
        "default": true
      },
      {
        "type": "text",
        "id": "whatsapp_number",
        "label": "WhatsApp number",
        "info": "Include country code, digits only — e.g. 919876543210 for +91 98765 43210",
        "default": "919876543210"
      },
      {
        "type": "textarea",
        "id": "whatsapp_message",
        "label": "Pre-filled message",
        "info": "Use [product] and [url] as placeholders.",
        "default": "Hi Nirvritti! I'd like to order [product] ([url])."
      },
      {
        "type": "checkbox",
        "id": "whatsapp_floating_button",
        "label": "Show floating WhatsApp button site-wide",
        "default": true
      }
    ]
  },
  {
    "name": "Payments",
    "settings": [
      {
        "type": "checkbox",
        "id": "payments_live",
        "label": "Online payments are set up in Shopify",
        "info": "Leave off while you're taking orders manually via WhatsApp / Cash on Delivery — this hides card/UPI badges so the footer doesn't promise a checkout method you don't support yet.",
        "default": false
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      { "type": "header", "content": "Accounts" },
      { "type": "text", "id": "social_instagram", "label": "Instagram URL" },
      { "type": "text", "id": "social_facebook", "label": "Facebook URL" },
      { "type": "text", "id": "social_youtube", "label": "YouTube URL" },
      { "type": "text", "id": "social_whatsapp", "label": "WhatsApp URL" }
    ]
  },
  {
    "name": "SEO & sharing",
    "settings": [
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Default social sharing image"
      }
    ]
  }
]
